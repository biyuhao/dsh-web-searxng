# DSH 本机/服务器环境变量（不要提交真实密码）
SEARXNG_BASE_URL=https://search.example.com
SEARXNG_USERNAME=dsh
SEARXNG_PASSWORD=change-me
# 出境代理（出境受限的机器必填；设置页可再开关）
# SEARXNG_PROXY_URL=socks5h://127.0.0.1:1080
# 代理默认开关（0/false/off 关闭，其余/缺省启用；设置页勾选框覆盖它）
# SEARXNG_PROXY_ENABLED=true
# 与 dsh-web 的 searchProvider 等价，二选一
# DSH_WEB_SEARCH_PROVIDER=searxng
